FORGE_S3_ACCESS_KEY_ID=
FORGE_S3_SECRET_ACCESS_KEY=
FORGE_S3_ENDPOINT=
FORGE_S3_BUCKET=
FORGE_S3_REGION=
FORGE_AGENT_SESSIONS_DIR=/absolute/path/to/forge-agent-sessions
# Optional. Defaults to $FORGE_AGENT_SESSIONS_DIR/resources and is created on startup.
FORGE_AGENT_RESOURCES_DIR=
FORGE_AGENT_ATTACHMENT_CACHE_DIR=
FORGE_AGENT_MAX_ATTACHMENT_BYTES=20971520
FORGE_AGENT_ATTACHMENT_CACHE_MAX_BYTES=104857600
FORGE_AGENT_MAX_MODEL_ROUNDS=16

PORT=8080
FORGE_ENVIRONMENT_ID=local
FORGE_ENVIRONMENT_NAME="Workspace cache"
FORGE_WORKSPACES_ROOT=/Users/divitoa/code/alecdivito/forge-editor/.workspace-cache
FORGE_WORKSPACES_JSON='[
  {"id":"demo","name":"Demo","path":"demo"},
  {"id":"example","name":"Example","path":"example"},
  {"id":"test","name":"Test","path":"test"},
  {"id":"typescript","name":"TypeScript","path":"typescript"}
]'
FORGE_DEFAULT_WORKSPACE=demo

